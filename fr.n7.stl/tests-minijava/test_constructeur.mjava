class Point {
    public int x;
    public int y;

    public Point(int _x, int _y) {
        this.x = _x;
        this.y = _y;
    }

    public int sum() {
        return this.x + this.y;
    }
}

public class Main {
    public static void main(String[] args) {
        Point p = new Point(10, 32);
        print p.sum();
    }
}
