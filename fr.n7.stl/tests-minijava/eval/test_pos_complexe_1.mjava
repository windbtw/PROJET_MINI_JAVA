class Shape {
    public int size;
    
    public Shape(int s) { 
        this.size = s; 
    }
    
    public int getSize() { 
        return this.size; 
    }
    
    public int compute() { 
        return 0; 
    }
}

class Rectangle extends Shape {
    public int width;
    
    public Rectangle(int s, int w) { 
        super(s); 
        this.width = w; 
    }
    
    public int compute() { 
        return this.width; 
    }
}

class Square extends Rectangle {
    public Square(int s) { 
        super(s, 1); 
    }
    
    public int compute() { 
        return (super.compute() + 1); 
    }
}

public class Main {
    public static void main(String[] args) {
        Shape s1 = new Shape(10);
        Shape s2 = new Rectangle(5, 8);
        Shape s3 = new Square(1);
        
        print s1.compute();
        print s2.compute();
        print s3.compute();
        print s3.getSize();
    }
}